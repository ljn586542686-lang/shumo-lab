{
  "schema_version": "1.0",
  "runner_mode": "dry-run",
  "default_dry_run": true,
  "allow_model_execution": false,
  "allow_paper_generation": false,
  "allow_final_submit_creation": false,
  "allow_gate_auto_approval": false,
  "allow_manual_approval_token_write": false,
  "input_files": {
    "status_panel": "pipeline_core/status/case_status.json",
    "quality_summary": "pipeline_core/evaluation/quality_evaluation_summary.json",
    "freeze_manifest": "pipeline_core/freeze/freeze_manifest.json"
  },
  "supported_commands": [
    "python pipeline_core/runner/run_case_pipeline.py --list-cases",
    "python pipeline_core/runner/run_case_pipeline.py --case-id case_10_real_prediction_timeseries_test --dry-run",
    "python pipeline_core/runner/run_case_pipeline.py --all --dry-run"
  ],
  "hard_safety_rules": [
    "final_submit_allowed=true must be reported as HIGH_RISK",
    "project root final_submit/ must be reported as HIGH_RISK",
    "human_review gates must not be auto-approved",
    "MANUAL_APPROVAL_BY_USER must not be written by runner",
    "formal PDFs must not be generated by runner",
    "case_05 must remain PARTIAL_MODEL_ONLY",
    "case_06/case_07/case_08 must remain mechanism fixtures",
    "case_09/case_10/case_11 must remain minimal-only closures"
  ],
  "output_files": {
    "dry_run_report": "pipeline_core/runner/runner_dry_run_report.md"
  }
}
